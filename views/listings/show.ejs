<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
  const bookings = <%- JSON.stringify(bookings) %>;
</script>

<div class="container mt-4">

  <!-- TITLE -->
  <div class="row mb-3">
    <div class="col-lg-8 offset-lg-2">
      <h3><%= listing.title %></h3>
    </div>
  </div>

  <!-- LISTING CARD -->
  <div class="row">
    <div class="col-lg-8 offset-lg-2">
      <div class="card show-card listing-card">

        <% if (listing.images.length) { %>
        <!-- CAROUSEL -->
        <div id="listingCarousel" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-inner">
            <% listing.images.forEach((img, i) => { %>
              <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                <img
                  src="<%= img.url %>"
                  class="d-block w-100 listing-carousel-img"
                  alt="listing image"
                />
              </div>
            <% }) %>
          </div>

          <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
          </button>

          <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
          </button>
        </div>
        <% } %>

        <!-- DETAILS -->
        <div class="card-body mt-3">
          <p class="card-text">Owned by <strong><%= listing.owner.username %></strong></p>
          <p class="card-text"><%= listing.description %></p>
          <p class="card-text fw-bold">&#8377;<%= listing.price.toLocaleString("en-IN") %> / night</p>
          <p class="card-text"><%= listing.location %></p> 
          <p class="card-text"><%= listing.country %></p>
        </div>
      </div>

      <% if (currUser) { %>
        <a href="/listings/<%= listing._id %>/book" class="btn btn-dark mt-3">Book Now</a>
      <% } %>
    </div>
  </div>

  <!-- AVAILABILITY CALENDAR -->
  <div class="row mt-4">
    <div class="col-lg-8 offset-lg-2">
      <h4>Availability</h4>
      <div id="availability-calendar"></div>
      <p class="text-muted small mt-2">Dates marked with a red slash are already booked.</p>
    </div>
  </div>

  <!-- EDIT / DELETE -->
  <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
  <div class="row mt-3">
    <div class="col-lg-8 offset-lg-2 btns">
      <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark Edit-btn">Edit</a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  </div>
  <% } %>

  <!-- REVIEW FORM -->
  <% if (currUser) { %>
  <div class="row mt-4">
    <div class="col-lg-8 offset-lg-2">
      <h4>Leave a review</h4>

      <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
        <div class="mb-3">
          <label class="form-label">Rating</label>
          <fieldset class="starability-slot">
            <input type="radio" name="review[rating]" value="1" checked />
            <input type="radio" id="r1" name="review[rating]" value="1" />
            <label for="r1">1 star</label>
            <input type="radio" id="r2" name="review[rating]" value="2" />
            <label for="r2">2 stars</label>
            <input type="radio" id="r3" name="review[rating]" value="3" />
            <label for="r3">3 stars</label>
            <input type="radio" id="r4" name="review[rating]" value="4" />
            <label for="r4">4 stars</label>
            <input type="radio" id="r5" name="review[rating]" value="5" />
            <label for="r5">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label class="form-label">Comments</label>
          <textarea
            name="review[comment]"
            class="form-control"
            rows="4"
            required
          ></textarea>
          <div class="invalid-feedback">Please add a comment</div>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
      </form>

      <hr />
    </div>
  </div>
  <% } %>

  <!-- REVIEWS -->
  <% if (listing.reviews.length > 0) { %>
  <div class="row">
    <div class="col-lg-8 offset-lg-2">
      <h4>All reviews</h4>

      <div class="row">
        <% for (let review of listing.reviews) { %>
        <div class="col-md-6 mb-3">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title">@<%= review.author.username %></h5>
              <p class="starability-result" data-rating="<%= review.rating %>"></p>
              <p class="card-text"><%= review.comment %></p>
              <p class="text-muted small">
                <%= review.createdAt ? review.createdAt.toDateString() : "" %>
              </p>

              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- MAP -->
  <div class="row mt-4 mb-5">
    <div class="col-lg-8 offset-lg-2">
      <h3>Where you'll be</h3>
      <div id="map"></div>
    </div>
  </div>

</div>

<script src="/js/map.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<style>
  /* diagonal slash on booked dates, since plain grey wasn't visible enough */
  .flatpickr-day.booked-day {
    position: relative;
    color: #999 !important;
    background: #f3f3f3 !important;
  }
  .flatpickr-day.booked-day::after {
    content: "";
    position: absolute;
    left: 6px;
    right: 6px;
    top: 50%;
    height: 2px;
    background: #dc3545;
    transform: rotate(-45deg);
  }
</style>
<script>
  // Build a set of individual booked date strings (yyyy-mm-dd) from the
  // listing's non-cancelled bookings. checkOut is exclusive (guest leaves
  // that day), so the checkout day itself is NOT marked booked.
  const bookedDates = new Set();
  bookings.forEach((b) => {
    let d = new Date(b.checkIn);
    const end = new Date(b.checkOut);
    while (d < end) {
      bookedDates.add(d.toISOString().slice(0, 10));
      d.setDate(d.getDate() + 1);
    }
  });

  flatpickr("#availability-calendar", {
    inline: true,
    showMonths: 1,
    minDate: "today",
    disable: [...bookedDates],
    clickOpens: false, // display-only
    onDayCreate: function (dObj, dStr, fp, dayElem) {
      const iso = dayElem.dateObj.toISOString().slice(0, 10);
      if (bookedDates.has(iso)) {
        dayElem.classList.add("booked-day");
      }
    },
  });
</script>